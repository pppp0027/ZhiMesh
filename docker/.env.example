# Copy this file to docker/.env and replace every CHANGE_ME value.
TZ=Asia/Shanghai
IMAGE_VERSION=local
APP_PROFILE=prod
HTTP_PORT=80
HTTP_BIND_ADDRESS=0.0.0.0
JAVA_OPTS=-Xms512m -Xmx1536m -XX:+HeapDumpOnOutOfMemoryError

# Public URLs. Use https://example.com when TLS is terminated by an outer proxy.
ZHIMESH_HOST=example.com
ZHIMESH_FRONTEND_URL=https://example.com
ZHIMESH_BACKEND_URL=https://example.com/api

# Required by the SSE benchmark because it creates an isolated conversation per request.
ZHIMESH_CONVERSATION_ENABLED=true
ZHIMESH_CONVERSATION_AUTO_CREATE_DEFAULT=false

# Short-term memory is Redis-only. Redis availability is required for stateful chat.
ZHIMESH_SHORT_MEMORY_TTL=0s
ZHIMESH_SHORT_MEMORY_MAX_VALUE_BYTES=1048576
ZHIMESH_SHORT_MEMORY_TURN_LOCK_WAIT=2s
ZHIMESH_SHORT_MEMORY_TURN_LOCK_LEASE=30s

# Retrieval storage. Changing the embedding model requires rebuilding vector data.
ZHIMESH_EMBEDDING_MODEL=local:bge-small-zh-v1.5
ZHIMESH_VECTOR_DATABASE=pgvector
ZHIMESH_GRAPH_DATABASE=apache-age
ZHIMESH_CANONICAL_CHUNK_ENABLED=true
ZHIMESH_BM25_ENABLED=true
ZHIMESH_BM25_AUTO_INDEX=true
ZHIMESH_BM25_TIMEOUT_MS=5000
ZHIMESH_BM25_TOP_K=5
ZHIMESH_BM25_K1=1.2
ZHIMESH_BM25_B=0.75
ZHIMESH_BM25_MAX_QUERY_TERMS=128
ZHIMESH_BM25_ANALYZER_VERSION=cjk-bigram-trigram-ident-v1

# Required only when ZHIMESH_VECTOR_DATABASE or ZHIMESH_GRAPH_DATABASE is neo4j.
ZHIMESH_NEO4J_HOST=host.docker.internal
ZHIMESH_NEO4J_PORT=7687
ZHIMESH_NEO4J_USERNAME=
ZHIMESH_NEO4J_PASSWORD=
ZHIMESH_NEO4J_DATABASE=neo4j

# PostgreSQL is an external dependency. Initialize it with server/db_migration/.
ZHIMESH_DB_HOST=host.docker.internal
ZHIMESH_DB_PORT=5432
ZHIMESH_DB_NAME=zhimesh
ZHIMESH_DB_USERNAME=CHANGE_ME
ZHIMESH_DB_PASSWORD=CHANGE_ME

# Mail is optional unless the corresponding feature is enabled.
ZHIMESH_MAIL_HOST=
ZHIMESH_MAIL_USERNAME=
ZHIMESH_MAIL_PASSWORD=

# Exactly 16 characters; never commit the real value.
ZHIMESH_ENCRYPT_AES_KEY=change-me-16char

# Optional image overrides.
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:1.27-alpine
