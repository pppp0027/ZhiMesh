<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pppp.zhimesh.common.mapper.KnowledgeBaseQaRecordReferenceMapper">
    <select id="listByQaUuid" resultType="com.pppp.zhimesh.common.entity.KnowledgeBaseQaRefEmbedding">
        select *
        from adi_knowledge_base_qa_ref_embedding a
        inner join adi_knowledge_base_qa b on a.qa_record_id = b.id
        where b.uuid = #{qaUuid}
    </select>

    <select id="listQaRecordIdsWithRefs" resultType="java.lang.Long">
        select distinct qa_record_id
        from adi_knowledge_base_qa_ref_embedding
        where qa_record_id in
        <foreach collection="qaRecordIds" item="qaRecordId" open="(" separator="," close=")">
            #{qaRecordId}
        </foreach>
    </select>

</mapper>
