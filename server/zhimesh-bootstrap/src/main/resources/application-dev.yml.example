# Copy this file to application-dev.yml and fill in the real database, Redis, and other connection information
# 复制本文件为 application-dev.yml，并填入真实的数据库、Redis 等连接信息
# Note: application-dev.yml is in .gitignore and will not be committed to the repository
# 注意：application-dev.yml 已在 .gitignore 中，不会被提交到代码仓库
# Sensitive information is injected via environment variables in the format ${ZHIMESH_XXX:default-value}
# 敏感信息通过环境变量注入，格式为 ${ZHIMESH_XXX:默认值}

spring:
  datasource:
    driver-class-name: org.postgresql.Driver
    url: jdbc:postgresql://${ZHIMESH_DB_HOST:localhost}:${ZHIMESH_DB_PORT:5432}/${ZHIMESH_DB_NAME:postgres}
    username: ${ZHIMESH_DB_USERNAME:your-username}
    password: ${ZHIMESH_DB_PASSWORD:your-password}
    hikari:
      # Connection timeout
      # 连接超时时间
      connection-timeout: 10000
      # Validation timeout
      # 验证超时时间
      validation-timeout: 3000
      # Idle timeout
      # 空闲超时时间
      idle-timeout: 60000
      # Login timeout
      # 登录超时时间
      login-timeout: 5
      # Maximum lifetime of a connection in the pool
      # 连接池中连接的最大生命周期
      max-lifetime: 300000
      # Maximum pool size
      # 连接池最大连接数
      maximum-pool-size: 10
      # Minimum idle connections
      # 连接池最小空闲连接数
      minimum-idle: 5
      # Read-only connections
      # 只读连接
      read-only: false
  data:
    redis:
      host: ${ZHIMESH_REDIS_HOST:localhost}
      port: ${ZHIMESH_REDIS_PORT:6379}
      password: ${ZHIMESH_REDIS_PASSWORD:}
      database: 0
      lettuce:
        pool:
          # Max connections in pool
          # 连接池最大连接数
          max-active: 20
          # Max blocking wait time in pool
          # 连接池最大阻塞等待时间
          max-wait: -1
          # Max idle connections in pool
          # 连接池中的最大空闲连接
          max-idle: 5
          # Min idle connections in pool
          # 连接池中的最小空闲连接
          min-idle: 1

logging:
  file:
    # Log file path
    # 日志文件路径
    path: ./data/zhimesh/logs
  level:
    com.baomidou.mybatisplus: DEBUG
    # Suppress the interceptor's repeated original/parse/finished SQL diagnostics.
    com.baomidou.mybatisplus.extension.plugins.inner.BlockAttackInnerInterceptor: WARN

zhimesh:
  # Frontend URL
  # 前端地址
  frontend-url: http://localhost:1002
  # Backend URL
  # 后端地址
  backend-url: http://localhost:1002/api
  indexing:
    canonical-chunk-enabled: ${ZHIMESH_CANONICAL_CHUNK_ENABLED:true}
    graph-concurrency: ${ZHIMESH_INDEXING_GRAPH_CONCURRENCY:1}
    graph-segment-concurrency: ${ZHIMESH_GRAPH_SEGMENT_CONCURRENCY:2}
    graph-request-concurrency: ${ZHIMESH_GRAPH_REQUEST_CONCURRENCY:2}
    graph-request-timeout-seconds: ${ZHIMESH_GRAPH_REQUEST_TIMEOUT_SECONDS:120}
    graph-request-max-attempts: ${ZHIMESH_GRAPH_REQUEST_MAX_ATTEMPTS:3}
    graph-retry-initial-backoff-ms: ${ZHIMESH_GRAPH_RETRY_INITIAL_BACKOFF_MS:2000}
    graph-retry-max-backoff-ms: ${ZHIMESH_GRAPH_RETRY_MAX_BACKOFF_MS:10000}
    # A DOING graphical status older than this is treated as abandoned and recovered to FAIL.
    graph-doing-timeout-minutes: ${ZHIMESH_GRAPH_DOING_TIMEOUT_MINUTES:60}
    embedding-concurrency: ${ZHIMESH_INDEXING_EMBEDDING_CONCURRENCY:2}
  # Daily OpenRouter free-model discovery and validation. The platform row must
  # be named exactly "OpenRouter" and contain its own API key.
  # OpenRouter 免费模型每天发现与验证；平台名必须精确为 OpenRouter，并配置 API Key。
  openrouter-sync:
    enabled: ${ZHIMESH_OPENROUTER_SYNC_ENABLED:true}
    platform-name: ${ZHIMESH_OPENROUTER_PLATFORM_NAME:OpenRouter}
    cron: "${ZHIMESH_OPENROUTER_SYNC_CRON:0 0 4 * * *}"
    zone: ${ZHIMESH_OPENROUTER_SYNC_ZONE:Asia/Shanghai}
    health-check-enabled: ${ZHIMESH_OPENROUTER_HEALTH_CHECK_ENABLED:true}
    health-check-cron: "${ZHIMESH_OPENROUTER_HEALTH_CHECK_CRON:0 0 0,9,14,19 * * *}"
    health-check-min-active-models: ${ZHIMESH_OPENROUTER_HEALTH_CHECK_MIN_ACTIVE_MODELS:5}
    health-check-max-probes-per-run: ${ZHIMESH_OPENROUTER_HEALTH_CHECK_MAX_PROBES_PER_RUN:20}
    active-run-timeout-minutes: ${ZHIMESH_OPENROUTER_ACTIVE_RUN_TIMEOUT_MINUTES:35}
    rate-limit-backoff-minutes: ${ZHIMESH_OPENROUTER_RATE_LIMIT_BACKOFF_MINUTES:10}
    min-context-tokens: ${ZHIMESH_OPENROUTER_MIN_CONTEXT_TOKENS:8192}
    max-catalog-p50-latency-ms: ${ZHIMESH_OPENROUTER_MAX_CATALOG_P50_LATENCY_MS:4000}
    min-catalog-throughput-tps: ${ZHIMESH_OPENROUTER_MIN_THROUGHPUT_TPS:12}
    min-catalog-uptime-1d: ${ZHIMESH_OPENROUTER_MIN_UPTIME_1D:98}
    max-probe-ttft-ms: ${ZHIMESH_OPENROUTER_MAX_PROBE_TTFT_MS:6000}
    max-probe-total-ms: ${ZHIMESH_OPENROUTER_MAX_PROBE_TOTAL_MS:15000}
    connect-timeout-ms: ${ZHIMESH_OPENROUTER_CONNECT_TIMEOUT_MS:5000}
    request-timeout-ms: ${ZHIMESH_OPENROUTER_REQUEST_TIMEOUT_MS:20000}
    probe-interval-ms: ${ZHIMESH_OPENROUTER_PROBE_INTERVAL_MS:4000}
    max-probes-per-run: ${ZHIMESH_OPENROUTER_MAX_PROBES_PER_RUN:100}
    # Existing OpenRouter models are validated first; discovery only fills a shortfall.
    # 先验证现有 OpenRouter 模型，仅在不足时补充到该数量。
    min-active-models: ${ZHIMESH_OPENROUTER_MIN_ACTIVE_MODELS:10}
    catch-up-after-hours: ${ZHIMESH_OPENROUTER_CATCH_UP_AFTER_HOURS:26}
    # Comma-separated exact model IDs that automation must never change.
    # 自动任务绝不修改的模型 ID，多个值使用逗号分隔。
    protected-models: ${ZHIMESH_OPENROUTER_PROTECTED_MODELS:}
  proxy:
    # Enable proxy
    # 是否启用代理
    enable: false
    host: 127.0.0.1
    http-port: 1087
  # Embedding model options (see embedding type data in adi_ai_model):
  # local:all-minilm-l6-v2 (Better for English, weaker for Chinese)
  # local:bge-small-zh-v1.5 (Default, better for Chinese, uses more memory than all-minilm-l6-v2)
  # openai:text-embedding-3-small, openai:text-embedding-3-large (Multilingual)
  # dashscope:text-embedding-v1, dashscope:text-embedding-v3 (Multilingual, better for Chinese)
  # Note: Different vector models with different dimensions generate incompatible vector spaces that cannot be stored in the same table for mixed search. Recommend deciding on a vector model and its dimensions early in the project. If changed later, vector data must be regenerated.
  # embedding model可选值如下（见adi_ai_model中的embedding类型的数据）：
  # local:all-minilm-l6-v2 (英文效果较好，中文效果较差)
  # local:bge-small-zh-v1.5 (默认、中文效果较好、相比 all-minilm-l6-v2 占用内存较大)
  # openai:text-embedding-3-small、openai:text-embedding-3-large (多语言)
  # dashscope:text-embedding-v1、dashscope:text-embedding-v3  (多语言，中文效果较好)
  # 注意：由于不同向量模型不同维度参数生成的向量特征空间不一致，无法兼容存储于一张表并进行混合搜索，建议项目初期确定好向量模型及其维度，后期如有修改，需重新生成向量数据
  embedding-model: local:bge-small-zh-v1.5
  # vector-database: pgvector, neo4j
  # vector-database: pgvector、neo4j
  vector-database: pgvector
  # graph-database: apache-age, neo4j
  # graph-database: apache-age、neo4j
  graph-database: apache-age
  datasource:
    neo4j:
      host: ${ZHIMESH_NEO4J_HOST:localhost}
      port: ${ZHIMESH_NEO4J_PORT:7687}
      username: ${ZHIMESH_NEO4J_USERNAME:neo4j}
      password: ${ZHIMESH_NEO4J_PASSWORD:your-db-password}
      # Database name
      # 数据库名称
      database: ${ZHIMESH_NEO4J_DATABASE:neo4j}

local:
  # Base data path for local file storage
  # 本地文件存储的基础路径
  base-data-path: ${ZHIMESH_LOCAL_BASE_DATA_PATH:/data/zhimesh}
  files: ${local.base-data-path}/files/
  images: ${local.base-data-path}/images/
  watermark-images: ${local.base-data-path}/mark-images/
  thumbnails: ${local.base-data-path}/thumbnails/
  watermark-thumbnails: ${local.base-data-path}/watermark-thumbnails/
  tmp-images: ${local.base-data-path}/tmp-images/
