{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://<username>:<password>@<host>:5432/<database>"
      ]
    },
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-redis-mcp",
        "redis://<host>:6379/0"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp",
        "--no-usageStatistics",
        "--headless",
        "--executablePath",
        "<chrome.exe绝对路径>"
      ]
    }
  }
}
