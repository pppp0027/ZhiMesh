# Login token returned by this project's /auth/login endpoint. Do not add Bearer.
ZHIMESH_ADMIN_TOKEN=

# Login token for a normal user. Used only by sse_benchmark.py.
# The benchmark never writes this value to its output.
ZHIMESH_USER_TOKEN=

# Optional automatic login for sse_benchmark.py. Prefer a dedicated benchmark user.
# These are used only when ZHIMESH_USER_TOKEN is empty.
ZHIMESH_USER_EMAIL=
ZHIMESH_USER_PASSWORD=

# Multi-user SSE account file. The serial baseline uses its first account, while
# concurrency runs use the requested number of accounts. Keep the real file out of Git.
ZHIMESH_BENCHMARK_ACCOUNTS_FILE=analysis/quantification/configs/concurrency-accounts.server.json

# Deployment-time endpoints and dataset. Precedence differs per script:
# - sse_benchmark.py: these env vars OVERRIDE the JSON config values.
# - collect_predictions.py: config values win; these are FALLBACKS used only
#   when the config key is null or missing (configs/server/*.json leave them
#   null on purpose).
# Local Docker Compose gateway: http://127.0.0.1/api
# Public end-to-end test: https://your-domain.example/api
ZHIMESH_API_BASE_URL=http://127.0.0.1/api
ZHIMESH_BENCHMARK_CHARACTER_UUID=
RAGAS_DATASET=datasets/ragas_eval_dataset_final.jsonl

# Fallback values for the server experiment configs (configs/server/*.json).
# Those configs intentionally leave the keys below null; collect_predictions.py
# reads them from here whenever the config value is null or missing.
# ZHIMESH_KB_UUID backs the config "kb_uuid" key: the knowledge base to evaluate.
# Needed for every configs/server/*.json run (set it to the target KB uuid).
ZHIMESH_KB_UUID=
# ZHIMESH_ANSWER_MODEL_ID backs the config "answer_model_id" key: the numeric id
# of the model that generates answers. Needed for every configs/server/*.json run.
ZHIMESH_ANSWER_MODEL_ID=

# Read-only PostgreSQL DSN used only by graph_quality.py.
# Example shape: postgresql://readonly_user:password@host:5432/database
ZHIMESH_DB_DSN=

# OpenAI-compatible judge configuration used by RAGAS.
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_BASE_URL=https://api.openai.com/v1
RAGAS_JUDGE_MODEL=gpt-4.1-mini
# Optional session id sent as x-opencode-session. Required by the opencode
# zen/go/v1 gateway; leave empty for providers that do not use it.
RAGAS_JUDGE_SESSION=
RAGAS_EMBEDDING_MODEL=text-embedding-3-small

# Optional: use a separate OpenAI-compatible embedding provider.
RAGAS_EMBEDDING_API_KEY=
RAGAS_EMBEDDING_BASE_URL=
