# T6 角色级 eval 跑分器环境变量样例
# 用法：cp .env.example .env 后填入真实值（.env 已被仓库 .gitignore 忽略）
# 安全红线：本仓库公开——严禁把真实账号口令或内网地址写入任何提交文件

# 后端基址（HTTP+SSE；本地默认值如下，跨机部署时替换为目标地址）
ZHIMESH_EVAL_BASE_URL=http://127.0.0.1:9999

# 评估账号（评估身份=李四，User.name 必须恰为「李四」：mock 名册、身份行注入
# 与 @caller 参数域约束都按姓名匹配。管理员建号时 name 须显式填「李四」——
# 留空会默认取邮箱本地部分导致全部对不上，见 README 前置条件）
# 前置条件：该账号必须已存在且可登录——runner 不创建账号；
# 同一邮箱连续错 3 次密码会进验证码模式，runner 无法再登录，须管理员重置
ZHIMESH_EVAL_USER_EMAIL=lisi@example.com
ZHIMESH_EVAL_USER_PASSWORD=CHANGE_ME

# ---- 以下可选 ----
# 设为 1 时 imageGated 场景真跑（含身份行注入/ArgScope 断言的新镜像口径）
# ZHIMESH_EVAL_STRICT_IMAGE=1
# 普通 REST 请求超时（秒，默认 30）
# ZHIMESH_EVAL_HTTP_TIMEOUT=30
# SSE 读超时（秒，默认 320；服务端 SSE 超时为 300，客户端须略大）
# ZHIMESH_EVAL_SSE_TIMEOUT=320
