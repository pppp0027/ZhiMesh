# ZhiMesh 服务器端环境变量模板
#
# 使用方法：
#   1. 复制为 /opt/zhimesh/.env（与 docker-compose.yml 同目录）
#   2. 把旧配置 /opt/zhimesh/config/zhimesh.env 的真实值填到对应变量
#   3. 本文件永远不要提交真实密码到 git 仓库
#
# 注意：ZHIMESH_DB_HOST / ZHIMESH_REDIS_HOST 已由 docker-compose.yml 固定覆盖为
#       host.docker.internal，这里的值仅作占位，无需修改。

# ── 镜像仓库（docker compose pull 拉镜像用）──
REGISTRY=ccr.ccs.tencentyun.com
REGISTRY_NAMESPACE=zhimesh

# ── 日志与运行数据目录（与旧部署一致，勿改）──
LOG_PATH=/opt/zhimesh/logs
ZHIMESH_LOCAL_BASE_DATA_PATH=/opt/zhimesh/data

# ── PostgreSQL（host 已由 compose 覆盖，填账号密码即可）──
ZHIMESH_DB_HOST=host.docker.internal
ZHIMESH_DB_PORT=5432
ZHIMESH_DB_NAME=ai_rag_knowledge
ZHIMESH_DB_USERNAME=root
ZHIMESH_DB_PASSWORD=CHANGE_ME

# ── Redis（host 已由 compose 覆盖）──
ZHIMESH_REDIS_HOST=host.docker.internal
ZHIMESH_REDIS_PORT=6379
ZHIMESH_REDIS_PASSWORD=

# ── AES 加密密钥（必须与旧部署完全一致，否则已加密数据无法解密）──
ZHIMESH_ENCRYPT_AES_KEY=CHANGE_ME

# ── RAG 存储方案 ──
ZHIMESH_EMBEDDING_MODEL=local:bge-small-zh-v1.5
ZHIMESH_VECTOR_DATABASE=pgvector
ZHIMESH_GRAPH_DATABASE=apache-age

# ── 会话 ──
ZHIMESH_CONVERSATION_ENABLED=true

# ── 演示注册开关：公网生产环境建议 false ──
ZHIMESH_DEMO_REGISTER_ENABLED=true
